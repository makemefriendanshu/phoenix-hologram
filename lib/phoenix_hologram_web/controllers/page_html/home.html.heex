<Layouts.flash_group flash={@flash} />
<div class="min-h-screen flex items-center justify-center px-4 py-16 sm:px-6">
  <div class="w-full max-w-xl">
    <div class="card-stock rounded-box shadow-xl px-6 py-10 sm:px-12 sm:py-14 text-center">
      <div class="flex justify-end -mt-4 -mr-2 mb-2">
        <Layouts.theme_toggle />
      </div>

      <p class="font-display text-xs tracking-[0.3em] uppercase text-primary">
        Phoenix Hologram <span class="badge badge-warning badge-sm ml-2 align-middle">Beta</span>
      </p>

      <div class="gold-divider w-24 mx-auto my-5"></div>

      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-balance">
        Watch your films, interactively
      </h1>

      <p class="mt-5 leading-7 text-base-content/70">
        Phoenix Hologram turns your videos into an interactive premiere: we detect
        every face on screen, index which scenes they appear in, and let you jump
        straight to the moments that matter — then screen it live with friends
        and family in a shared Premiere Hall.
      </p>

      <div class="gold-divider w-24 mx-auto my-8"></div>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/premiere" class="btn btn-primary">
          Browse the Premiere Hall
        </a>
        <a href="/admin" class="btn btn-outline btn-secondary">
          View Recognised Faces
        </a>
      </div>
    </div>
  </div>
</div>
